# Every name here must exist in src/shared/config/env.schema.ts.
# The service refuses to start if any is missing or malformed.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sell2rent
# Host port for the docker-compose database. Change only if 5432 is taken.
DB_PORT=5432

PORT=3000
NODE_ENV=development
LOG_LEVEL=info
PROPERTIES_FEED_PATH=./data/properties.json
